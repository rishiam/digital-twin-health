# ============================================================
# DigiTwin Health — environment template
# Copy to .env (root), apps/web/.env.local, and apps/api/.env
# Never commit real secrets.
# ============================================================

# --- App ---
APP_NAME=DigiTwin Health
APP_ENV=production
APP_URL=https://digitwin-health.vercel.app
API_URL=https://digitwin-health-api.up.railway.app
CORS_ORIGINS=https://digitwin-health.vercel.app,http://localhost:3000

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Storage ---
SUPABASE_STORAGE_BUCKET=digitwin-uploads

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SENTRY_DSN=

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Optional LLM for RAG assistant ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=local

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Demo seed ---
SEED_DEMO_USERS=true
